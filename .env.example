# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# Database (Supabase / Neon free tier)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatdb

# JWT (use long random strings, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Upstash free tier: rediss://...)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (Supabase Storage / Cloudflare R2)
S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=chat-uploads
S3_FORCE_PATH_STYLE=true
